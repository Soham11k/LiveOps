# Warehouse backend: duckdb (local default) or snowflake
WAREHOUSE_BACKEND=duckdb

# dbt target override (duckdb | snowflake). Defaults to profiles.yml env.
# DBT_TARGET=duckdb

# --- Snowflake trial (required when WAREHOUSE_BACKEND=snowflake) ---
# Account identifier looks like xy12345.us-east-1 or org-account
# Prefer SNOWPITCH_LOADER after applying transform/snowflake/05_rbac.sql
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWPITCH
SNOWFLAKE_SCHEMA=BRONZE
